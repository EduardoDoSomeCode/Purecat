{
  "appId": "com.purecat.editor",
  "productName": "PureCat",
  "directories": {
    "app": ".",
    "output": "dist",
    "buildResources": "assets"
  },
  "extraResources": [
    {
      "from": "python_env",
      "to": "python_env",
      "filter": ["**/*"]
    }
  ],
  "files": [
    "main/**/*",
    "renderer/**/*",
    "package.json"
  ],
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "AudioVideo",
    "icon": "assets/icon.png",
    "maintainer": "PureCat Team <team@purecat.app>"
  },
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "assets/icon.ico"
  },
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "category": "public.app-category.video",
    "icon": "assets/icon.icns"
  },
  "npmRebuild": false,
  "nodeGypRebuild": false
}